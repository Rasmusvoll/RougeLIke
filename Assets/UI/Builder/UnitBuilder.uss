.root {
    flex-grow: 1;
    flex-direction: row;
    color: rgb(43, 31, 26);
    font-size: 14px;
}

.panel {
    background-color: rgb(234, 217, 176);
    padding: 14px;
}

.side {
    width: 280px;
    border-right-width: 1px;
    border-right-color: rgb(160, 132, 88);
}

.side-right {
    width: 360px;
    border-left-width: 1px;
    border-left-color: rgb(160, 132, 88);
}

.center {
    flex-grow: 1;
    flex-direction: column;
}

.header {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    border-bottom-width: 1px;
    border-bottom-color: rgb(160, 132, 88);
}

.footer {
    border-top-width: 1px;
    border-top-color: rgb(160, 132, 88);
}

.preview {
    flex-grow: 1;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 10px;
}

.hint {
    color: rgba(43, 31, 26, 0.6);
    font-size: 12px;
}

.title {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.section {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(107, 74, 47);
    margin-top: 14px;
    margin-bottom: 6px;
    letter-spacing: 1px;
}

.row {
    flex-direction: row;
    align-items: center;
    min-height: 34px;
    padding: 4px 8px;
    margin-bottom: 4px;
    border-radius: 6px;
    background-color: rgb(242, 228, 196);
    border-width: 2px;
    border-color: rgb(205, 181, 130);
}

.row:hover {
    border-color: rgb(107, 74, 47);
}

.row.selected {
    border-color: rgb(194, 86, 43);
    background-color: rgb(247, 222, 178);
}

.row.dim {
    opacity: 0.45;
}

.grow {
    flex-grow: 1;
    flex-shrink: 1;
}

.sub {
    font-size: 12px;
    color: rgb(107, 74, 47);
}

.empty {
    color: rgb(150, 125, 95);
    -unity-font-style: italic;
}

.count {
    -unity-font-style: bold;
    margin-left: 6px;
    margin-right: 6px;
}

.cost {
    color: rgb(63, 110, 148);
    margin-left: 6px;
    margin-right: 6px;
}

.warn {
    color: rgb(194, 86, 43);
    font-size: 12px;
}

.error {
    color: rgb(158, 59, 42);
    margin-top: 6px;
}

Button {
    margin: 0 0 0 6px;
    padding: 4px 10px;
    border-radius: 5px;
    border-width: 0;
    background-color: rgb(107, 74, 47);
    color: rgb(242, 228, 196);
}

Button:hover {
    background-color: rgb(133, 95, 62);
}

Button:disabled {
    opacity: 0.35;
}

Button.primary {
    background-color: rgb(63, 110, 148);
}

Button.primary:hover {
    background-color: rgb(80, 132, 172);
}

Button.danger {
    background-color: rgb(158, 59, 42);
}

Button.danger:hover {
    background-color: rgb(182, 74, 52);
}

Button.confirm {
    background-color: rgb(194, 86, 43);
}

Button.chip {
    margin: 0 6px 6px 0;
}

Button.chip.selected {
    background-color: rgb(209, 154, 58);
}

TextField {
    min-width: 200px;
    margin-right: 12px;
}

.energy-track {
    height: 14px;
    border-radius: 7px;
    background-color: rgb(205, 181, 130);
    margin-top: 4px;
    margin-bottom: 10px;
    overflow: hidden;
}

.energy-fill {
    height: 100%;
    background-color: rgb(63, 110, 148);
    border-radius: 7px;
}

.energy-fill.full {
    background-color: rgb(209, 154, 58);
}

.stats {
    flex-direction: row;
    flex-wrap: wrap;
}

.stat {
    width: 20%;
    min-width: 110px;
    margin-bottom: 4px;
}

.stat-value {
    font-size: 20px;
    -unity-font-style: bold;
}

.up {
    color: rgb(79, 107, 58);
}

.down {
    color: rgb(158, 59, 42);
}

TextField .unity-base-text-field__input {
    background-color: rgb(242, 228, 196);
    border-color: rgb(160, 132, 88);
    color: rgb(43, 31, 26);
    padding: 4px 8px;
}

.preview .hint {
    color: rgba(242, 228, 196, 0.85);
}
