/* Battle screen. Shared storybook styles (fonts, buttons, cards) come from UnitBuilder.uss. */

.battle-root {
    flex-grow: 1;
    flex-direction: column;
    padding: 10px;
}

.battle-top {
    flex-direction: row;
    align-items: center;
    padding: 10px 18px;
}

.battle-top .title {
    font-size: 28px;
}

.battle-middle {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.battle-hint {
    position: absolute;
    bottom: 12px;
    color: rgb(242, 228, 196);
    background-color: rgba(43, 31, 26, 0.82);
    border-radius: 14px;
    padding: 4px 16px;
    font-size: 15px;
    -unity-font-definition: url("../Fonts/AlegreyaSans-MediumItalic_SDF.asset");
}

.battle-bottom {
    flex-shrink: 0;
    padding: 12px 18px 10px 18px;
}

.battle-cards {
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    padding-top: 8px;
}

.battle-card {
    width: 330px;
    margin-right: 8px;
    padding: 10px 12px;
}

.battle-result {
    min-width: 380px;
    max-width: 480px;
    align-items: center;
    padding: 28px 32px;
}

.battle-result-title {
    font-size: 56px;
    -unity-font-definition: url("../Fonts/AlegreyaSC-ExtraBold_SDF.asset");
    margin-bottom: 6px;
}

.battle-result .sub {
    font-size: 16px;
    -unity-text-align: middle-center;
}
