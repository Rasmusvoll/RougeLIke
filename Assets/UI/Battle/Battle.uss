/* Battle screen. Shared storybook styles (fonts, buttons, cards) come from UnitBuilder.uss. */

.battle-root {
    flex-grow: 1;
    flex-direction: column;
    padding: 10px;
}

.battle-top {
    flex-direction: row;
    align-items: center;
    padding: 10px 18px;
}

.battle-top .title {
    font-size: 28px;
}

.battle-middle {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.battle-hint {
    position: absolute;
    bottom: 12px;
    color: rgb(242, 228, 196);
    background-color: rgba(43, 31, 26, 0.82);
    border-radius: 14px;
    padding: 4px 16px;
    font-size: 15px;
    -unity-font-definition: url("../Fonts/AlegreyaSans-MediumItalic_SDF.asset");
}

.battle-bottom {
    flex-shrink: 0;
    padding: 12px 18px 10px 18px;
}

.battle-cards {
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    padding-top: 8px;
}

.battle-card {
    width: 330px;
    margin-right: 8px;
    padding: 10px 12px;
}

.battle-result {
    min-width: 380px;
    max-width: 480px;
    align-items: center;
    padding: 28px 32px;
}

.battle-result-title {
    font-size: 56px;
    -unity-font-definition: url("../Fonts/AlegreyaSC-ExtraBold_SDF.asset");
    margin-bottom: 6px;
}

.battle-result .sub {
    font-size: 16px;
    -unity-text-align: middle-center;
}

/* Rewards: three cards dealt onto the victory panel. */

.battle-result.with-rewards {
    max-width: none;
}

.reward-row {
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
    margin-bottom: 16px;
}

.reward-card {
    width: 230px;
    margin: 0 8px;
    padding: 14px 14px 12px 14px;
    align-items: center;
    -unity-slice-left: 14;
    -unity-slice-right: 14;
    -unity-slice-top: 14;
    -unity-slice-bottom: 14;
    border-radius: 10px;
    opacity: 0;
    translate: 0 70px;
    scale: 0.6 0.6;
    rotate: -10deg;
    transition-property: opacity, translate, scale, rotate, -unity-background-image-tint-color;
    transition-duration: 0.18s, 0.42s, 0.42s, 0.42s, 0.1s;
    transition-timing-function: ease-out, ease-out-back, ease-out-back, ease-out-back, linear;
}

.reward-card.revealed {
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
    rotate: 0deg;
}

.reward-card.revealed:hover {
    translate: 0 -6px;
    -unity-background-image-tint-color: rgb(255, 250, 240);
}

.reward-card.chosen {
    translate: 0 -14px;
    scale: 1.08 1.08;
    border-width: 3px;
    border-color: rgb(209, 154, 58);
}

.reward-card.passed {
    opacity: 0.35;
    scale: 0.92 0.92;
}

.reward-kind {
    margin-bottom: 8px;
}

.socket.huge {
    width: 96px;
    height: 96px;
    margin-right: 0;
    margin-bottom: 8px;
}

.reward-name {
    font-size: 22px;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.reward-info {
    flex-grow: 1;
    align-items: center;
    margin-bottom: 10px;
}

.reward-info .chips {
    justify-content: center;
}

.reward-info .pips {
    margin-bottom: 4px;
}

.reward-card Button {
    align-self: stretch;
}

.battle-result .reward-card .sub {
    font-size: 14px;
}

Button.skip {
    font-size: 16px;
}
