.battle-root {
    flex-grow: 1;
    flex-direction: column;
    color: rgb(43, 31, 26);
    font-size: 14px;
}

.battle-top {
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgb(160, 132, 88);
    background-color: rgba(234, 217, 176, 0.97);
}

.battle-middle {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.battle-hint {
    position: absolute;
    bottom: 10px;
    color: rgb(242, 228, 196);
    background-color: rgba(43, 31, 26, 0.8);
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 13px;
}

.battle-bottom {
    flex-shrink: 0;
    border-top-width: 1px;
    border-top-color: rgb(160, 132, 88);
    background-color: rgba(234, 217, 176, 0.97);
    padding-top: 10px;
    padding-bottom: 8px;
}

.battle-cards {
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    padding-top: 8px;
}

.battle-card {
    width: 230px;
    margin-right: 8px;
    padding: 8px 10px;
    align-items: flex-start;
}

.battle-result {
    min-width: 340px;
    max-width: 440px;
    align-items: center;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(107, 74, 47);
    background-color: rgb(234, 217, 176);
    padding: 24px;
}

.battle-result-title {
    font-size: 36px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

Button.big {
    font-size: 16px;
    padding: 8px 18px;
    -unity-font-style: bold;
}

